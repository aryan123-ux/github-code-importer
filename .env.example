# API Sentinel — add these in Lovable (never commit real keys).

# 1. Browser-safe values (add to the project's .env / environment panel)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_STRIPE_PRO_PLAN_URL=https://buy.stripe.com/your_pro_link
VITE_STRIPE_ENTERPRISE_PLAN_URL=https://buy.stripe.com/your_enterprise_link

# 2. Private server secret (Lovable → Project Settings → Secrets). Never prefix with VITE_.
ANTHROPIC_API_KEY=sk-ant-replace_me
# Optional: ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Legacy/optional
STRIPE_SECRET_KEY=sk_live_replace_me
GITHUB_WEBHOOK_SECRET=replace_with_random_hex
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
